    CONTROL         "Not Operational",IDC_CHECK_ALTIRATE1,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,218,83,67,10
    LTEXT           "4) On the ADTS, set the ADC altitude rate of 2000 ft/min and set the ADC altitude to a lower value.",IDC_STATIC,26,103,317,8
    LTEXT           "5) Observe the altitude rate value from the box.",IDC_STATIC,26,121,153,8
    LTEXT           "6) Observed value is achieved 2000 ft/min mark the status as Operational else Not Operational.",IDC_STATIC,26,137,309,8
    LTEXT           "4.05) Altitude rate at 2000 ft/min ",IDC_STATIC,73,162,105,8
    CONTROL         "Not Operational",IDC_CHECK_ALTIRATE2,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,220,160,67,10
END


