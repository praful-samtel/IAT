IDD_DIALOG_VISUAL_INSPECTION DIALOGEX 0, 0, 416, 257
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ISIS Visual Inspection (Test No. 1.01 to 1.09)"
FONT 11, "Arial", 400, 0, 0x0
BEGIN
    LTEXT           "1.01) Enter the FC Display Unit Part Number ",IDC_STATIC,42,40,148,8
    LTEXT           "1.03) Enter the Air Data Unit (ADU) Part Number ",IDC_STATIC,42,73,170,8
    LTEXT           "1.04) Enter the Magnetometer Sensor Part Number ",IDC_STATIC,42,91,167,8
    LTEXT           "1.05) Enter the AHRS Part number ",IDC_STATIC,42,107,126,8
    PUSHBUTTON      "Continue",IDOK,190,232,50,14
    LTEXT           "1.06) Inspect for any corrosion on the ISIS System ",IDC_STATIC,41,139,178,12
    CONTROL         "NO",IDC_CHECK_ISIS_DAMAGE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,283,139,50,10
    LTEXT           "1.07) Inspect for any foreign material the ISIS System",IDC_STATIC,41,158,186,10
    CONTROL         "NO",IDC_CHECK_ISIS_SCRATCHES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,283,157,24,11
    LTEXT           "1.08) Inspect for loose screws on the ISIS System",IDC_STATIC,41,178,191,9
    CONTROL         "NO",IDC_CHECK_ISIS_SCREW,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,283,176,52,10
    LTEXT           "1.09)Check if any pins connectos are bend on the ISIS System",IDC_STATIC,41,198,203,12
    CONTROL         "NO",IDC_CHECK_ISIS_PINS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,283,196,54,10
    LTEXT           "1) Enter the part number written on the ISIS System.",IDC_STATIC,21,21,178,9
    EDITTEXT        IDC_EDIT_ISISDUPN,244,36,63,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_ISISADUPN,244,69,63,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_ISISMMSPN,244,86,63,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_ISISAHRSPN,244,104,63,14,ES_AUTOHSCROLL
    LTEXT           " IS2100000000",IDC_STATIC,335,39,50,8
    LTEXT           "AN-014-ADU-V00",IDC_STATIC,335,70,58,8
    LTEXT           "AN-015-MMS-V00",IDC_STATIC,335,87,59,8
    LTEXT           "1901400000000",IDC_STATIC,335,105,53,8
    GROUPBOX        "Specifications",IDC_STATIC,331,29,71,89
    LTEXT           "1.02) Enter the RC Display Unit Part Number ",IDC_STATIC,42,57,153,8
    EDITTEXT        IDC_EDIT_ISISDUPNRC,244,52,63,14,ES_AUTOHSCROLL
    LTEXT           " IS2100000000",IDC_STATIC,335,54,50,8
    LTEXT           "3) Click Continue button to proceed for the next Test.",IDC_STATIC,24,215,169,9
    LTEXT           "Test Procedure :",IDC_STATIC,14,9,50,8
    LTEXT           "2) Inspect the ISIS System for the following defects. Select the corresponding checkbox only if the defect is present.",IDC_STATIC,23,123,379,9
END

IDD_DIALOG_LCD_PANEL_CHECK DIALOGEX 0, 0, 314, 149
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Other Checks (Test 9.01 to 9.09)"
FONT 11, "Arial", 400, 0, 0x0
BEGIN
    CONTROL         "No",IDC_CHECK_BREAKAGE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,235,16,25,10
    CONTROL         "No",IDC_CHECK_CONDENSATION,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,235,26,25,10
    CONTROL         "No",IDC_CHECK_STAIN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,235,37,25,10
    CONTROL         "No",IDC_CHECK_GREYSCALE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,235,61,25,10
    CONTROL         "No",IDC_CHECK_SCRATCH,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,235,73,25,10
    CONTROL         "No",IDC_CHECK_DUST,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,235,104,25,10
    CONTROL         "No",IDC_CHECK_DECOLRATION,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,235,83,25,10
    CONTROL         "No",IDC_CHECK_DELAMINATION,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,235,93,25,10
    CONTROL         "No",IDC_CHECK_LIGHT_LEAKAGE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,235,48,25,10
    DEFPUSHBUTTON   "Continue",IDOK,143,127,50,14
    LTEXT           "9.01 Breakage",IDC_STATIC,26,19,176,10
    LTEXT           "9.02 Condensation",IDC_STATIC,26,30,176,10
    LTEXT           "9.03 Stain",IDC_STATIC,26,40,176,8
    CONTROL         "No",IDC_CHECK_COLORSHIFT,"Button",BS_AUTOCHECKBOX | NOT WS_VISIBLE | WS_TABSTOP,28,138,25,10
    CONTROL         "No",IDC_CHECK_BRIGHTNESS,"Button",BS_AUTOCHECKBOX | NOT WS_VISIBLE | WS_TABSTOP,38,138,25,10
    CONTROL         "No",IDC_CHECK_FRINGE,"Button",BS_AUTOCHECKBOX | NOT WS_VISIBLE | WS_TABSTOP,29,137,25,10
    LTEXT           "9.05 Scratch",IDC_STATIC,26,63,176,8
    LTEXT           "9.06 Dust/Humidity Penetration",IDC_STATIC,26,74,176,8
    CONTROL         "No",IDC_CHECK_SCREWS,"Button",BS_AUTOCHECKBOX | NOT WS_VISIBLE | WS_TABSTOP,44,139,25,10
    CONTROL         "No",IDC_CHECK_CORRSON,"Button",BS_AUTOCHECKBOX | NOT WS_VISIBLE | WS_TABSTOP,19,136,25,10
    LTEXT           "9.09 Light Leakage",IDC_STATIC,26,108,176,8
    LTEXT           "9.07 Loosing of Screws",IDC_STATIC,26,85,176,9
    LTEXT           "9.08 Corrosion",IDC_STATIC,26,95,176,10
    LTEXT           "9.04 Gray Scale Inversion",IDC_STATIC,26,52,176,10
END

