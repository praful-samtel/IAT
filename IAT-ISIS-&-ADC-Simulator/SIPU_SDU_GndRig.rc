/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "&Open...\tCtrl+O",            ID_FILE_OPEN
        MENUITEM SEPARATOR
        MENUITEM "&Print...\tCtrl+P",           ID_FILE_RPTPRINT
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP ""
    BEGIN
        MENUITEM "&Maximize\tCtrl+M",           ID_EDIT_MAXIMIZEVIEWPANNEL, GRAYED
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About MFD Test Bench",       ID_APP_ABOUT
        MENUITEM "Application &Help (F1)",      ID_HELP, INACTIVE
    END
END


