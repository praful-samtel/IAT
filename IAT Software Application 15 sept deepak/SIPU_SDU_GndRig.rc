IDD_DIALOG_ISIS_ADU DIALOGEX 0, 0, 482, 303
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ISIS ADU Checks(Test No. 9.01 to 9.08)"
FONT 11, "Arial", 400, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "Continue",IDOK,289,282,50,14
    LTEXT           "1) Turn on ADTS and connect the pitot and static tubes to the ADU and perform the following tests :",IDC_STATIC,28,18,325,8
    LTEXT           "",IDC_STATIC,0,30,8,8
    LTEXT           "9.01)Set Airspeed as 189 Knots and 3000 ft altitude on ADTS ,wait for the ADTS to reach the given pressure and enter the AirSpeed value from ISIS-DU FC.Click on Test button to get the value.",IDC_STATIC,43,42,287,25
    LTEXT           "9.02)Set Altitude as 10000 ft and 30 CAS Knots on ADTS,wait for the ADTS to reach the given pressure and enter the Altitude value from ISIS-DU FC.Click on Test button to get the value.",IDC_STATIC,43,70,286,23
    LTEXT           "9.03)Set Altitude as 13123 ft and CAS as189 Knots,wait for the ADTS to reach the given pressure and enter the Mach No. from ISIS-DU FC.Click on Test button to get the value.",IDC_STATIC,43,97,289,17
    LTEXT           "9.04)Set the Vertical speed as 6000 ft/min. Set altitude to 0 Check Vertical speed marking to be observed at 6000 ft/min mark (lower most marking of VSI scale) on ISIS-DU FC.Set the status as Operational/Not Operational.",IDC_STATIC,43,120,284,25
    EDITTEXT        IDC_EDIT_ISIS_AIRSPEED,353,46,52,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_ISIS_ALTITUDE,353,69,52,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_ISIS_MACH,353,97,52,14,ES_AUTOHSCROLL
    CONTROL         "Not Operational",IDC_CHECK_ISIS_VERTICAL_SPEED,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,356,124,63,10
    LTEXT           "192±5 knots",IDC_STATIC,423,49,48,8
    LTEXT           "9980±30 Ft",IDC_STATIC,424,72,37,8
    LTEXT           "0.37± 0.012 M",IDC_STATIC,422,98,47,8
    GROUPBOX        "Specifiactions",IDC_STATIC,412,39,60,72
    LTEXT           "2) Click on continue button to finish the ISIS Test procedure.",IDC_STATIC,29,270,193,8
    LTEXT           "Test Procedure :",IDC_STATIC,15,8,60,8
    PUSHBUTTON      "Test",IDC_BUTTON_ARINCRX,170,282,50,14
    LTEXT           "9.05)Set Airspeed as 189 Knots and 3000 ft altitude on ADTS ,wait for the ADTS to reach the given pressure and enter the AirSpeed value from ISIS-DU RC.Click on Test button to Get the value.",IDC_STATIC,42,163,280,23
    LTEXT           "9.06)Set Altitude as 10000 ft and 30 CAS Knots on ADTS,wait for the ADTS to reach the given pressure and enter the Altitude value from ISIS-DU RC.Click on Test button to Get the value.",IDC_STATIC,42,191,286,24
    LTEXT           "9.07)Set Altitude as 13123 ft and CAS as189 Knots,wait for the ADTS to reach the given pressure and enter the Mach No. from ISIS-DU RC.Click on Test button to Get the value.",IDC_STATIC,42,217,289,17
    LTEXT           "9.08)Set the Vertical speed as 6000 ft/min. Set altitude to 0 Check Vertical speed marking to be observed at 6000 ft/min mark (lower most marking of VSI scale) on ISIS-DU RC.Set the status as Operational/Not Operational.",IDC_STATIC,42,240,284,25
    EDITTEXT        IDC_EDIT_ISIS_AIRSPEED2,352,168,52,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_ISIS_ALTITUDE2,352,191,52,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_ISIS_MACH2,352,220,52,14,ES_AUTOHSCROLL
    CONTROL         "Not Operational",IDC_CHECK_ISIS_VERTICAL_SPEED2,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,355,247,63,10
    LTEXT           "192±5 knots",IDC_STATIC,422,172,48,8
    LTEXT           "9980±30 Ft",IDC_STATIC,423,196,37,8
    LTEXT           "0.37± 0.012 M",IDC_STATIC,422,222,46,8
    GROUPBOX        "Specifiactions",IDC_STATIC,414,164,60,72
    LTEXT           "- ADU Checks with ISIS-DU FC :",IDC_STATIC,36,30,101,8,WS_BORDER
    LTEXT           "- ADU Checks with ISIS-DU RC :",IDC_STATIC,36,149,101,8,WS_BORDER
