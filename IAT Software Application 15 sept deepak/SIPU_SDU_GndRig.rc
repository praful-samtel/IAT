IDD_DIALOG_VISUAL_INSPECTION DIALOGEX 0, 0, 416, 257
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ISIS Visual Inspection (Test No. 1.01 to 1.09)"
FONT 11, "Arial", 400, 0, 0x0
BEGIN
    LTEXT           "1.01) Enter the FC Display Unit Part Number ",IDC_STATIC,42,40,148,8
    LTEXT           "1.03) Enter the Air Data Unit (ADU) Part Number ",IDC_STATIC,42,73,170,8
    LTEXT           "1.04) Enter the Magnetometer Sensor Part Number ",IDC_STATIC,42,91,167,8
    LTEXT           "1.05) Enter the AHRS Part number ",IDC_STATIC,42,107,126,8
    PUSHBUTTON      "Continue",IDOK,190,232,50,14
    LTEXT           "1.06) Inspect for any corrosion on the ISIS System ",IDC_STATIC,41,139,178,11
    CONTROL         "NO",IDC_CHECK_ISIS_DAMAGE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,283,139,50,10
    LTEXT           "1.07) Inspect for any foreign material the ISIS System",IDC_STATIC,41,158,186,10
    CONTROL         "NO",IDC_CHECK_ISIS_SCRATCHES,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,283,157,24,11
    LTEXT           "1.08) Inspect for loose screws on the ISIS System",IDC_STATIC,41,178,191,9
    CONTROL         "NO",IDC_CHECK_ISIS_SCREW,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,283,176,52,10
    LTEXT           "1.09)Check if any pins connectos are bend on the ISIS System",IDC_STATIC,41,198,203,12
    CONTROL         "NO",IDC_CHECK_ISIS_PINS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,283,196,54,10
    LTEXT           "1) Enter the part number written on the ISIS System.",IDC_STATIC,21,21,178,9
    EDITTEXT        IDC_EDIT_ISISDUPN,244,36,63,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_ISISADUPN,244,69,63,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_ISISMMSPN,244,86,63,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDIT_ISISAHRSPN,244,104,63,14,ES_AUTOHSCROLL
    LTEXT           " IS2100000000",IDC_STATIC,335,39,50,8
    LTEXT           "AN-014-ADU-V00",IDC_STATIC,335,70,58,8
    LTEXT           "AN-015-MMS-V00",IDC_STATIC,335,87,59,8
    LTEXT           "1901400000000",IDC_STATIC,335,105,53,8
    GROUPBOX        "Specifications",IDC_STATIC,331,29,71,89
    LTEXT           "1.02) Enter the RC Display Unit Part Number ",IDC_STATIC,42,57,153,8
    EDITTEXT        IDC_EDIT_ISISDUPNRC,244,52,63,14,ES_AUTOHSCROLL
    LTEXT           " IS2100000000",IDC_STATIC,335,54,50,8
    LTEXT           "3) Click Continue button to proceed for the next Test.",IDC_STATIC,24,215,169,9
    LTEXT           "Test Procedure :",IDC_STATIC,14,9,50,8
    LTEXT           "2) Inspect the ISIS System for the following defects. Select the corresponding checkbox only if the defect is present.",IDC_STATIC,23,123,379,9
END

IDD_DIALOG_ISIS_IBIT DIALOGEX 0, 0, 498, 295
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ISIS DU IBIT CHECKS (Test No. 4.01 to 4.02)"
FONT 11, "Arial", 400, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "Continue",IDOK,233,269,50,14
    LTEXT           "Test Procedure  for IBIT check of ISIS DU FC :",IDC_STATIC,15,11,157,8
    LTEXT           "1) Press NAV + ALN  keys on DU FC for more than 2 seconds to enter IBIT Maintenance Page.",IDC_STATIC,33,28,312,8
    LTEXT           "2) Following IBIT status page shall display ADU,AHRS,MMS and FC status.",IDC_STATIC,33,42,270,8
    LTEXT           "3) GREEN indication is system PASS. Any RED indication is FAIL.",IDC_STATIC,33,56,214,8
    LTEXT           "4) The FC Status shall display FC in the display unit.",IDC_STATIC,33,70,224,8
    LTEXT           "4.01 ) ISIS FC DU IBIT Status ",IDC_STATIC,66,106,99,8
    CONTROL         "Not Operational",IDC_CHECK_ISISFC_IBIT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,191,105,67,10
    LTEXT           "4.02) ISIS RC DU IBIT Status ",IDC_STATIC,65,234,97,8
    CONTROL         "Not Operational",IDC_CHECK_ISISRC_IBIT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,191,233,67,10
    LTEXT           "Click on continue button to proceed for the next Test.",IDC_STATIC,20,253,179,8
    LTEXT           "Test Procedure  for IBIT check of ISIS DU RC :",IDC_STATIC,16,130,156,8
    LTEXT           "1) Press NAV + ALN  keys on DU RC for more than 2 seconds to enter IBIT Maintenance Page.",IDC_STATIC,37,149,311,8
    LTEXT           "2) Following IBIT status page shall display ADU,AHRS,MMS and RC status.",IDC_STATIC,37,162,270,8
    LTEXT           "3) GREEN indication is system PASS. Any RED indication is FAIL.",IDC_STATIC,37,176,214,8
    LTEXT           "4) The RC Status shall display RC in the display unit.",IDC_STATIC,37,191,224,8
    CONTROL         650,IDC_STATIC,"Static",SS_BITMAP,390,18,100,94
    CONTROL         651,IDC_STATIC,"Static",SS_BITMAP,391,162,100,94
    LTEXT           "5) Based on the steps mentioned above mark the status as Operational / Not Operational.",IDC_STATIC,33,83,300,9
    LTEXT           "5) Based on the steps mentioned above mark the status as Operational / Not Operational.",IDC_STATIC,37,207,300,9
END

IDD_DIALOG_ISIS_BRT DIALOGEX 0, 0, 503, 284
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ISIS BRT and SET Knob Checks (Test No. 5.01 to 5.02)"
FONT 11, "Arial", 400, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "Continue",IDOK,228,261,50,14
    LTEXT           "Test Procedure for Brightness control and Set Knob checks of ISIS-DU FC :",IDC_STATIC,15,11,248,8
    LTEXT           "1) Momentarily Press NAV + ALN keys for less than 2 seconds to enter brightness control mode.",IDC_STATIC,29,30,319,8
    LTEXT           "2)The graphical overlay indicating Brightness can be observed on the main page .",IDC_STATIC,29,43,263,8
    LTEXT           "3) Rotate the Set Knob clockwise to increase the Brightness.",IDC_STATIC,29,57,215,8
    LTEXT           "4) Rotate the Set Knob Anti-clockwise to decrease the Brightness.",IDC_STATIC,29,70,215,8
    LTEXT           "5.01) ISIS-DU FC Brightness and SET knob Status ",IDC_STATIC,61,102,167,8
    CONTROL         "Not Operational",IDC_CHECK_ISISFC_BRT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,266,101,67,10
    CONTROL         "Not Operational",IDC_CHECK_ISISRC_BRT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,267,219,67,10
    LTEXT           "5.02) ISIS-DU RC Brightness and SET knob Status ",IDC_STATIC,62,220,168,8
    LTEXT           "Click on continue button to proceed for the next Test.",IDC_STATIC,18,243,179,8
    LTEXT           "Test Procedure for Brightness control and Set Knob checks of ISIS-DU RC :",IDC_STATIC,19,123,256,8
    LTEXT           "1) Momentarily Press NAV + ALN keys for less than 2 seconds to enter brightness control mode.",IDC_STATIC,31,143,316,8
    LTEXT           "2)The graphical overlay indicating Brightness can be observed on the main page .",IDC_STATIC,31,156,263,8
    LTEXT           "3) Rotate the Set Knob clockwise to increase the Brightness.",IDC_STATIC,31,171,215,8
    LTEXT           "4) Rotate the Set Knob Anti-clockwise to decrease the Brightness.",IDC_STATIC,31,185,215,8
    CONTROL         649,IDC_STATIC,"Static",SS_BITMAP,371,33,100,96
    LTEXT           "5) Based on the steps mentioned above mark the status as Operational / Not Operational.",IDC_STATIC,29,83,300,9
    LTEXT           "5) Based on the steps mentioned above mark the status as Operational / Not Operational.",IDC_STATIC,31,201,300,9
END

IDD_DIALOG_ISIS_ALN DIALOGEX 0, 0, 504, 273
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ISIS Alignment mode check (Test No. 6.01 to 6.02) "
FONT 11, "Arial", 400, 0, 0x0
BEGIN
    DEFPUSHBUTTON   "Continue",IDOK,231,250,50,14
    LTEXT           "Test Procedure for Alignment mode checks of  ISIS-DU FC:",IDC_STATIC,17,11,204,8
    LTEXT           "1) Press ALN Button on ISIS-DU FC.",IDC_STATIC,32,26,149,8
    LTEXT           "2) The respective DUs will initiate alignment. This process may take approx. 20 secs.",IDC_STATIC,32,40,284,8
    LTEXT           "3) During alignment the caption ""Alignment in progess"" shall be displayed on the DU FC.",IDC_STATIC,33,54,298,8
    LTEXT           "4) Post successful alignment the DU shall be back to main page.",IDC_STATIC,33,68,220,8
    LTEXT           "6.01) ISIS-DU FC Alignment mode Status",IDC_STATIC,62,104,134,8
    CONTROL         "Not Operational",IDC_CHECK_ISISFC_ALN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,245,103,67,10
    CONTROL         "Not Operational",IDC_CHECK_ISISRC_ALN,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,249,218,67,10
    LTEXT           "6) Click on continue button to proceed for the next Test.",IDC_STATIC,20,235,179,8
    LTEXT           "6.02) ISIS-DU RC Alignment mode Status",IDC_STATIC,64,218,135,8
    LTEXT           "2) The respective DUs will initiate alignment. This process may take approx. 20 secs.",IDC_STATIC,34,156,276,8
    LTEXT           "3) During alignment the caption ""Alignment in progess"" shall be displayed on the DU RC.",IDC_STATIC,34,171,276,8
    LTEXT           "4) Post successful alignment the DU shall be back to main page.",IDC_STATIC,34,185,216,8
    LTEXT           "Test Procedure for Alignment mode checks of  ISIS-DU RC:",IDC_STATIC,19,125,209,8
    LTEXT           "1) Press ALN Button on ISIS-DU RC.",IDC_STATIC,34,143,149,8
